# Скопируйте в .env для локального запуска, либо задайте эти же переменные
# в настройках сервиса на Render/Fly.io — .env файл туда не заливается.

# Длинная случайная строка, например: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-string

# Получить через: python generate_admin_hash.py
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash

# false только для локальной разработки на http://localhost
COOKIE_SECURE=true
